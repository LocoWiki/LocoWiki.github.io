<Application x:Class="LocoWiki.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F1115" />
        <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#15181F" />
        <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#262B35" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8B93A7" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5AA9FF" />
    </Application.Resources>
</Application>
