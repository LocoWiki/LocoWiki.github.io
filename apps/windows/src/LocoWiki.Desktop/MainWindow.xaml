<Window x:Class="LocoWiki.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="LocoWiki"
        Height="760"
        Width="1280"
        MinHeight="560"
        MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Icon="Assets/locoWiki.ico"
        PreviewKeyDown="OnPreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <wv2:WebView2 x:Name="WebView" />

            <Border x:Name="Splash" Background="{StaticResource WindowBackgroundBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="LocoWiki"
                               FontSize="44"
                               FontWeight="SemiBold"
                               Foreground="#F2F5FA"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="机器人知识库 · 桌面客户端"
                               FontSize="14"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,10,0,30"
                               HorizontalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True"
                                 Width="200"
                                 Height="3"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="#232833"
                                 BorderThickness="0" />
                    <TextBlock x:Name="SplashText"
                               Text="正在连接 locowiki.com…"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,18,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource StatusBarBackgroundBrush}"
                BorderBrush="{StaticResource StatusBarBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="14,0" Height="30">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot"
                             Width="7"
                             Height="7"
                             Fill="#4ADE80"
                             Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText"
                               Text="在线 · 网络优先"
                               FontSize="11"
                               Foreground="#A9B2C3"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="CacheText"
                               Text="缓存 0 B"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <Button x:Name="RefreshButton"
                            Content="刷新"
                            FontSize="11"
                            Padding="12,3"
                            Background="#1E2430"
                            Foreground="#D7DEEA"
                            BorderBrush="#2E3646"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="OnRefreshClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
